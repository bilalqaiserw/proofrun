# Copy this file to .env in this same directory, then paste your key there.
# Never upload or commit .env. The key is read by the Node backend only.
BOBSHELL_API_KEY=
# Optional only for General keys:
# BOB_TEAM_ID=
# Optional Bob Shell executable, or JavaScript entrypoint:
# BOB_BIN=
# BOB_JS_ENTRY=
BOB_MAX_COST=2
PORT=3000
# PROOFRUN_DATA_DIR=.proofrun-data
# PROOFRUN_DOCKER_BIN=docker
# Optional server-owned runtime registry for additional/multi-language images:
# PROOFRUN_RUNTIME_IMAGES={"custom":"your-trusted-image:tag"}
